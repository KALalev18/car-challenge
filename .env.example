# Copy to .env.local and fill in ONE of the two keys. Never commit .env.local.
ANTHROPIC_API_KEY=
# Or an OpenRouter key (used when ANTHROPIC_API_KEY is empty):
OPENROUTER_API_KEY=

# Optional
# AGENT_MODEL=claude-opus-5-5     # with OpenRouter: anthropic/claude-opus-5.5
# AGENT_EFFORT=medium             # low | medium | high
# SIM_MODEL=                      # the simulated drivers and sites; defaults to AGENT_MODEL
# SIM_REPLY_DELAY_MS=6000         # how long the simulated driver takes to answer
